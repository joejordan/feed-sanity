      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git checkout .)",
      "Bash(git branch -D*)",
      "Bash(sudo:*)",
      "Bash(shutdown:*)",
      "Bash(reboot:*)",
      "Bash(mkfs:*)",
      "Bash(dd:*)"
    ]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "showTurnDuration": true,
  "respectGitignore": false,
  "statusLine": {
    "type": "command",
    "command": "node .claude/statusline-command.mjs",
